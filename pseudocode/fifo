FIFO(reference_string, frame_max)

    frames = array of size frame_max initialized to EMPTY
    pointer = 0
    page_faults = 0

    For each page in reference_string

        found = false

        For i = 0 to frame_max - 1

            If frames[i] == page
                found = true
                break

        If found == false

            page_faults = page_faults + 1

            frames[pointer] = page

            pointer = (pointer + 1) mod frame_max

    Return page_faults
