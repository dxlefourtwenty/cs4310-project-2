OPTIMAL(reference_string, frame_max)

    frames = array of size frame_max initialized to EMPTY

    page_faults = 0

    For current_index = 0 to length(reference_string) - 1

        current_page = reference_string[current_index]

        found = false

        For i = 0 to frame_max - 1

            If frames[i] == current_page
                found = true
                break

        If found == false

            page_faults = page_faults + 1

            empty_index = -1

            For i = 0 to frame_max - 1

                If frames[i] == EMPTY
                    empty_index = i
                    break

            If empty_index != -1

                frames[empty_index] = current_page

            Else

                victim_index = -1
                farthest_use = -1

                For i = 0 to frame_max - 1

                    next_use = INFINITY

                    For j = current_index + 1 to length(reference_string) - 1

                        If reference_string[j] == frames[i]

                            next_use = j
                            break

                    If next_use == INFINITY

                        victim_index = i
                        break

                    If next_use > farthest_use

                        farthest_use = next_use
                        victim_index = i

                frames[victim_index] = current_page

    Return page_faults
