LRU(reference_string, frame_max)

    frames = array of size frame_max initialized to EMPTY
    last_used = array of size frame_max initialized to -1

    time = 0
    page_faults = 0

    For each page in reference_string

        time = time + 1

        found = false

        For i = 0 to frame_max - 1

            If frames[i] == page

                found = true
                last_used[i] = time
                break

        If found == false

            page_faults = page_faults + 1

            empty_index = -1

            For i = 0 to frame_max - 1

                If frames[i] == EMPTY
                    empty_index = i
                    break

            If empty_index != -1

                frames[empty_index] = page
                last_used[empty_index] = time

            Else

                victim_index = 0

                For i = 1 to frame_max - 1

                    If last_used[i] < last_used[victim_index]
                        victim_index = i

                frames[victim_index] = page
                last_used[victim_index] = time

    Return page_faults
